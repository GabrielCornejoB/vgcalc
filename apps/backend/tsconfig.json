{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
        "@models": ["./src/domain/models/index.ts"],
        "@ports": ["./src/domain/ports/index.ts"],
        "@use-cases": ["./src/domain/use-cases/index.ts"],
        "@handlers": ["./src/in/http/handlers/index.ts"],
        "@schemas": ["./src/in/http/schemas/index.ts"],
        "@routers": ["./src/in/http/routers/index.ts"]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  }
}
